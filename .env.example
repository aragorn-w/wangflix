# =============================================================================
# media-stack runtime configuration template
# =============================================================================
# Copy to `.env` (which is gitignored) and fill values.  Every variable below
# is consumed by one or more scripts in this repo; if you add a new override,
# document it here so future operators (and agents) have a single source of
# truth for the environment contract.
#
# Legend:
#   [REQUIRED] container/script will refuse to start without it
#   [OPTIONAL] script falls back to the default shown
# =============================================================================


# -----------------------------------------------------------------------------
# ProtonVPN WireGuard — Gluetun container
# -----------------------------------------------------------------------------
# [REQUIRED] docker-compose.yml uses ${VAR:?...} expansion, so missing values
# block the gluetun container start.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESS=

# [OPTIONAL, default: Switzerland] Gluetun SERVER_COUNTRIES.  Core mandate:
# DVR traffic must egress through a non-Five-Eyes jurisdiction.
VPN_COUNTRY=Switzerland

# [OPTIONAL, default: 10.0.0.0/24,100.64.0.0/10] Gluetun
# FIREWALL_OUTBOUND_SUBNETS — which subnets containers in gluetun's
# network namespace can reach for OUTBOUND-initiated traffic (inbound
# to published ports already works via conntrack regardless of this).
# Default covers a generic private LAN (10.0.0.0/24) + Tailscale CGNAT
# (100.64.0.0/10).  Replicators on a different LAN should override:
# the first comma-separated value is your LAN subnet.
# FIREWALL_OUTBOUND_SUBNETS=10.0.0.0/24,100.64.0.0/10


# -----------------------------------------------------------------------------
# Arr API keys
# -----------------------------------------------------------------------------
# [REQUIRED for nuke_stalled.py + bazarr-profile-audit.py + unpackerr]
# Find them at:
#   Sonarr  → Settings → General → Security → API Key
#   Radarr  → Settings → General → Security → API Key
SONARR_API_KEY=
RADARR_API_KEY=

# [OPTIONAL] Service URL overrides — defaults assume the in-stack containers
# bind to the host LAN IP on the documented ports.  Override only if you
# moved a service or you're driving the script from another box.
# SONARR_URL=http://10.0.0.10:8989
# RADARR_URL=http://10.0.0.10:7878
# QBIT_URL=http://10.0.0.10:8090


# -----------------------------------------------------------------------------
# qBittorrent host-side credentials
# -----------------------------------------------------------------------------
# qBit WebUI auth.  As of 2026-05-19 the host-side `nuke_stalled.py` reaper
# logs in via these credentials before issuing torrent operations (codex
# round-3 finding #8).  Defaults assume the stock qBit `admin` user with
# the password generated on first boot.
QBIT_USER=admin
QBIT_PASS=


# -----------------------------------------------------------------------------
# Bazarr profile audit
# -----------------------------------------------------------------------------
# [OPTIONAL] bazarr-profile-audit.py — fixes Radarr/Sonarr-imported items
# that Bazarr added with profileId=None (silently undiscoverable for sub
# search).  Defaults match the in-stack Bazarr; override for split-host setups.
# BAZARR_URL=http://10.0.0.10:6767
# BAZARR_DEFAULT_PROFILE_ID=1


# -----------------------------------------------------------------------------
# Stall reaper tuning
# -----------------------------------------------------------------------------
# [OPTIONAL, default: 300] nuke_stalled.py — seconds a torrent may be in
# stalledDL/metaDL before being removed + blocklisted.  Lower for aggressive
# clean-up on a noisy indexer, higher to tolerate slow trackers.
# STALL_THRESHOLD_SEC=300


# -----------------------------------------------------------------------------
# Audio normalization driver
# -----------------------------------------------------------------------------
# [OPTIONAL, default: 5] normalize-driver.sh JOBS — ffmpeg pass2 workers in
# parallel.  History on this 8-core/HDD box:
#   JOBS=8 → 78% fail (UHD pass2 timeouts)
#   JOBS=6 → 50% fail
#   JOBS=5 → 0% on ≤30GB / ~17-19% UHD long tail (production winner)
#   JOBS=3 → 0% fail / slower
# JOBS=5

# [OPTIONAL, default: 360] normalize-driver.sh STUCK_MIN — minutes a sweep
# can run without a FIXED line before the watchdog reaps it.  Set above
# the max(pass1, pass2) timeout for the largest expected file.
# STUCK_MIN=360


# -----------------------------------------------------------------------------
# Telegram notifications
# -----------------------------------------------------------------------------
# normalize-driver.sh + ops/healthcheck-alert.sh notify on completion /
# failure via the Telegram Bot API.  The bot token is read from an
# external file managed by the Claude Telegram plugin — NOT this repo.
# Set TELEGRAM_CHAT_ID to your own chat ID (numeric, find via @userinfobot
# on Telegram).  Absent → notify is skipped with a stderr warning.
# TELEGRAM_CHAT_ID=


# -----------------------------------------------------------------------------
# Host identity (single source of truth for paths + LAN IP)
# -----------------------------------------------------------------------------
# Every script that needs to know where this stack lives or where its
# media library is sources these values from .env (via lib/paths.sh for
# shell scripts and media_paths.py for Python).  Replicators only need
# to set these once.
#
# IMPORTANT: this .env is parsed by NON-EXECUTING parsers (lib/paths.sh
# + media_stack.paths.load_env_file).  Variable references like `$HOME`
# or `${MEDIA_STACK_ROOT}` are NOT expanded — they would be stored as
# literal strings.  Write fully expanded absolute paths if you override.

# [OPTIONAL, default: derived as the directory containing this .env]
# absolute path to this repo checkout.  Scripts derive sibling paths
# (config/, data/, var/) from it.  Example absolute override (substitute
# your own user / install path):
# MEDIA_STACK_ROOT=/path/to/media-stack
#
# CHECKOUT-LOCATION CAVEAT: the directory-derived default applies to the
# SHELL/PYTHON scripts (lib/paths.sh, media_stack.paths) only.
# docker-compose.yml cannot run those helpers, so its volume mounts fall
# back to the literal `$HOME/media-stack` when this var is unset.  If your
# checkout is NOT at `$HOME/media-stack`, you MUST set MEDIA_STACK_ROOT
# (and MEDIA_ROOT below) here as absolute paths, or `docker compose` will
# bind-mount config/ and media from the wrong directory.

# [OPTIONAL, default: ${MEDIA_STACK_ROOT}/data/media — derived at script
# load time, so the literal-string caveat above doesn't apply to the
# default] absolute path to the media library root containing tv/ and
# movies/.  Override if your media lives outside the stack tree (mergerfs
# pool, NFS mount, etc.).  Use a fully expanded absolute path:
# MEDIA_ROOT=/path/to/media-stack/data/media

# [OPTIONAL, default: 10.0.0.10] LAN IP this host listens on.  Used to
# build service URLs for host-side scripts (SONARR_URL, RADARR_URL,
# QBIT_URL, BAZARR_URL) and for healthcheck.sh API probes.  Published
# docker port bindings in docker-compose.yml are intentionally NOT
# scoped to this IP — admin ports bind to all interfaces (0.0.0.0)
# because the perimeter is Tailscale + Tailnet Lock + no public iface +
# UFW deliberately off (see docker-compose.yml header for the explicit
# rationale).  If you replicate on a host with a public interface,
# manually narrow the compose `ports:` lines or front the services with
# a reverse proxy.
# MEDIA_LAN_IP=10.0.0.10

# [OPTIONAL, default: /srv/calibre/library] absolute path to the Calibre
# library bind-mounted into Kavita as /books.  Replicators with a Calibre
# library elsewhere should override.
# CALIBRE_LIBRARY=/srv/calibre/library

# [OPTIONAL, defaults below] PUID/PGID/TZ propagated into every container
# that runs as a non-root user (LinuxServer images, Jellyfin, Bazarr…).
# 1000 is the default UID/GID for the first user on most Debian/Ubuntu
# installs; if your unprivileged user has a different UID, override here.
# PUID=1000
# PGID=1000
# TZ=UTC

# [OPTIONAL, default: MEDIA_LAN_IP] Jellyfin's PublishedServerUrl —
# the address Jellyfin advertises to clients on the local network for
# direct play.  Defaults to MEDIA_LAN_IP so LAN clients get a working
# URL out of the box.  Set this to your own Tailscale MagicDNS name
# (or external hostname) for remote-discovery scenarios.  Example:
# JELLYFIN_PUBLISHED_URL=media.example.ts.net


# -----------------------------------------------------------------------------
# Less-common toggles (documented for completeness)
# -----------------------------------------------------------------------------
# normalize-loop.sh — caps the number of normalize-driver.sh iterations
# the orchestrator will run before exiting.  Default 5; raise to drive
# longer headless runs.
# MAX_ITERS=5

# ops/install.sh — INSTALL-TIME toggle (pass on the install.sh command
# line; NOT loaded into the running stack).  When set to 1, host-specific
# systemd units (realtek-fix.service) are INSTALLED to /etc/systemd/system
# (for inspection) — but NOT auto-enabled; the installer always leaves
# host-specific units disabled, so enable them manually if your hardware
# matches.  Default 0 = skip them entirely, since they only apply to
# matching hardware.
#   INCLUDE_HOST_SPECIFIC=1 bash ops/install.sh --apply
#   sudo systemctl enable --now realtek-fix.service   # then, if applicable
# INCLUDE_HOST_SPECIFIC=0



# -----------------------------------------------------------------------------
# jellyfin-mint-api-key.py (ops helper, not auto-invoked)
# -----------------------------------------------------------------------------
# These vars are consumed by `jellyfin-mint-api-key.py` when minting a new
# admin API key.  They are NOT auto-loaded into the running stack — only
# the script reads them, and only when invoked explicitly:
#
#   JELLYFIN_API_KEY=<existing-admin-key> \
#   JELLYFIN_VERIFY_USER=<admin-username> \
#   JELLYFIN_VERIFY_PW=<that-user's-password> \
#       python3 jellyfin-mint-api-key.py <new-key-name>
#
# Don't store them in .env — pass via shell env at invocation time so the
# bootstrap key + verification password don't sit on disk in plaintext.
# JELLYFIN_URL defaults to http://{MEDIA_LAN_IP}:8096 from
# media_stack.paths; override only for split-host setups.
# JELLYFIN_URL=http://10.0.0.10:8096
# JELLYFIN_API_KEY=       # NEVER set in .env — pass at invocation
# JELLYFIN_VERIFY_USER=   # NEVER set in .env — pass at invocation
# JELLYFIN_VERIFY_PW=     # NEVER set in .env — pass at invocation

# healthcheck.sh — perimeter-assertion override.  The check FAILS by
# default if the host has any publicly-routable IPv4 or IPv6 address,
# because admin ports bind to all interfaces and would be exposed.
# Set this to 1 ONLY if you've explicitly fronted the admin services
# with an auth-handling reverse proxy.  Default 0 (enforce).
# ALLOW_PUBLIC_IFACE=0


# -----------------------------------------------------------------------------
# Runtime artifact tree (var/) — advanced
# -----------------------------------------------------------------------------
# All four VAR_* paths default to ${MEDIA_STACK_ROOT}/var/<subdir>; override
# only if you want stack-level logs / locks / state / reviews on a different
# filesystem (e.g. an SSD subset of a mergerfs pool).  Same precedence as
# the other paths: process env > .env > default.
#
# IMPORTANT: per-file media locks (.consolidate-<name>.lock) intentionally
# live next to the media file, NOT under VAR_RUN — flock requires same-
# filesystem semantics, so the lock must sit on the same mount as the file
# it guards.  Overriding VAR_RUN moves stack-level locks (driver mutex,
# etc.) but does NOT change media-lock placement.
#
# IMPORTANT: this .env is parsed by NON-EXECUTING parsers (lib/paths.sh
# + media_stack.paths.load_env_file).  Variable references like
# `${VAR_DIR}` or `$HOME` are NOT expanded — they would be stored as
# literal strings.  Write fully expanded absolute paths if you override
# any of these.
# VAR_DIR=/path/to/media-stack/var
# VAR_LOG=/path/to/media-stack/var/log
# VAR_RUN=/path/to/media-stack/var/run
# VAR_STATE=/path/to/media-stack/var/state
# VAR_REVIEWS=/path/to/media-stack/var/reviews
